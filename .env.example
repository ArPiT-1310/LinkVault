# Leave empty in development (the Vite proxy is used).
# In production set it to your deployed API, e.g. https://linkvault-api.onrender.com/api
VITE_API_URL=
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:your_mysql_password}
...
jwt.secret=${JWT_SECRET:change-this-to-a-long-random-string-of-at-least-32-characters}